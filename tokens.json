{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "SimpleAccess Design System Tokens",
    "version": "1.0.0",
    "specification": "W3C Design Tokens Community Group (DTCG) 2025.10",
    "description": "Multi-sensory design tokens engineered for WCAG 2.2 AA compliance across sight, sound, and touch.",
    "author": "Scott Davis <scott@thirstyhead.com>"
  },
  "color": {
    "palette": {
      "navy": {
        "$value": "#002d62",
        "$type": "color",
        "$description": "SimpleAccess Primary Navy - WCAG AAA 14.3:1 contrast on white canvas"
      },
      "navy_hover": {
        "$value": "#004494",
        "$type": "color",
        "$description": "Hover state blue for interactive controls"
      },
      "navy_dark": {
        "$value": "#0a192f",
        "$type": "color",
        "$description": "Deep Navy for dark mode canvas surface"
      },
      "gold": {
        "$value": "#ffd700",
        "$type": "color",
        "$description": "SimpleAccess Brand Gold Accent - 9.5:1 contrast against navy"
      },
      "gold_metallic": {
        "$value": "#d4af37",
        "$type": "color",
        "$description": "Metallic Gold Focus Ring - 4.1:1 non-text contrast against navy, 3.4:1 against canvas"
      },
      "charcoal": {
        "$value": "#1a1a1a",
        "$type": "color",
        "$description": "Primary reading text - 17.6:1 contrast on white, 15.5:1 on canvas"
      },
      "muted_charcoal": {
        "$value": "#444444",
        "$type": "color",
        "$description": "Secondary descriptive text - 9.7:1 contrast on white"
      },
      "canvas": {
        "$value": "#f4f4f4",
        "$type": "color",
        "$description": "Off-white page canvas background"
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Card, navigation, and modal surface background"
      },
      "blue_soft": {
        "$value": "#e8f0fe",
        "$type": "color",
        "$description": "Validation and test-suite container background"
      },
      "blue_header": {
        "$value": "#d0def7",
        "$type": "color",
        "$description": "Table header row background"
      },
      "border_light": {
        "$value": "#dddddd",
        "$type": "color",
        "$description": "Subtle border line"
      },
      "border_card": {
        "$value": "#cbd5e1",
        "$type": "color",
        "$description": "Card and reference border"
      },
      "code_bg": {
        "$value": "#eeeeee",
        "$type": "color",
        "$description": "Inline code snippet background"
      }
    },
    "sys": {
      "bg": {
        "canvas": {
          "$value": "{color.palette.canvas}",
          "$type": "color",
          "$description": "Page canvas background"
        },
        "surface": {
          "$value": "{color.palette.white}",
          "$type": "color",
          "$description": "Component surface background"
        },
        "container": {
          "$value": "{color.palette.blue_soft}",
          "$type": "color",
          "$description": "Callout and test-suite container background"
        }
      },
      "text": {
        "main": {
          "$value": "{color.palette.charcoal}",
          "$type": "color",
          "$description": "Primary body and heading text"
        },
        "muted": {
          "$value": "{color.palette.muted_charcoal}",
          "$type": "color",
          "$description": "Subheadings and supporting descriptions"
        },
        "inverse": {
          "$value": "{color.palette.white}",
          "$type": "color",
          "$description": "Text placed on navy headers and buttons"
        },
        "accent": {
          "$value": "{color.palette.navy}",
          "$type": "color",
          "$description": "Card headers and primary text anchors"
        }
      },
      "interactive": {
        "primary": {
          "$value": "{color.palette.navy}",
          "$type": "color",
          "$description": "Default interactive button and link color"
        },
        "hover": {
          "$value": "{color.palette.navy_hover}",
          "$type": "color",
          "$description": "Hovered state background"
        },
        "focus": {
          "$value": "{color.palette.gold_metallic}",
          "$type": "color",
          "$description": "High-contrast focus ring indicator"
        },
        "accent": {
          "$value": "{color.palette.gold}",
          "$type": "color",
          "$description": "Brand highlight and decorative borders"
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "main": {
        "$value": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "$type": "fontFamily",
        "$description": "System sans-serif stack for maximum legibility and zero web-font latency"
      },
      "mono": {
        "$value": "ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace",
        "$type": "fontFamily",
        "$description": "Monospace stack for semantic HTML tags and code blocks"
      }
    },
    "scale": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "md": { "$value": "1.1rem", "$type": "dimension" },
      "lg": { "$value": "1.4rem", "$type": "dimension" },
      "xl": { "$value": "1.75rem", "$type": "dimension" },
      "xxl": { "$value": "2.25rem", "$type": "dimension" },
      "display": { "$value": "3rem", "$type": "dimension" }
    },
    "fontWeight": {
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium": { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold": { "$value": 700, "$type": "fontWeight" }
    },
    "lineHeight": {
      "tight": { "$value": 1.2, "$type": "number", "$description": "Headings" },
      "body": { "$value": 1.7, "$type": "number", "$description": "Comfortable body reading line height" }
    }
  },
  "spacing": {
    "xs": { "$value": "0.25rem", "$type": "dimension" },
    "sm": { "$value": "0.5rem", "$type": "dimension" },
    "md": { "$value": "1rem", "$type": "dimension" },
    "lg": { "$value": "1.5rem", "$type": "dimension" },
    "xl": { "$value": "2rem", "$type": "dimension" },
    "xxl": { "$value": "3rem", "$type": "dimension" },
    "huge": { "$value": "4rem", "$type": "dimension" },
    "hero": { "$value": "5rem", "$type": "dimension" }
  },
  "layout": {
    "container_max": { "$value": "900px", "$type": "dimension" },
    "main_max": { "$value": "1100px", "$type": "dimension" },
    "grid_min_card": { "$value": "300px", "$type": "dimension" }
  },
  "border": {
    "radius_sm": { "$value": "4px", "$type": "dimension" },
    "radius_md": { "$value": "8px", "$type": "dimension" },
    "radius_lg": { "$value": "12px", "$type": "dimension" },
    "accent_header": { "$value": "6px", "$type": "dimension" },
    "card_lead": { "$value": "8px", "$type": "dimension" }
  },
  "elevation": {
    "nav": { "$value": "0 2px 5px rgba(0,0,0,0.1)", "$type": "shadow" },
    "card": { "$value": "0 4px 12px rgba(0,0,0,0.05)", "$type": "shadow" },
    "hero": { "$value": "0 15px 35px rgba(0,0,0,0.1)", "$type": "shadow" }
  },
  "touch": {
    "min_target": {
      "$value": "44px",
      "$type": "dimension",
      "$description": "Minimum touch and click target size exceeding WCAG 2.2 SC 2.5.8 (24px) for universal ergonomic ease"
    }
  },
  "sensory": {
    "audio": {
      "earcon_freq": {
        "$value": 440,
        "$type": "number",
        "$description": "A4 440Hz warm harmonic frequency for interactive confirmations"
      },
      "earcon_duration": {
        "$value": 0.06,
        "$type": "duration",
        "$description": "60ms brief acoustic cue"
      }
    },
    "haptic": {
      "tap_pattern": {
        "$value": "[12]",
        "$type": "string",
        "$description": "12ms subtle tactile tick for mobile sensory feedback"
      }
    },
    "motion": {
      "transition_fast": {
        "$value": "0.2s ease",
        "$type": "string",
        "$description": "Subtle interactive feedback transition"
      }
    }
  }
}